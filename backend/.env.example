# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# MongoDB Atlas (one line, no quotes). Special characters in the password are URL-encoded automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
MONGODB_DB=tritorc_seo

SITE_ID=tritorc
SITE_URL=https://www.tritorc.com
PORT=8790

# Google
GA4_PROPERTY_ID=
GSC_PROPERTY=https://tritorc.com/
# Full path to the service-account JSON key (keep it outside the repository):
GOOGLE_SERVICE_ACCOUNT_FILE=
# API key for PageSpeed + CrUX:
GOOGLE_API_KEY=

# GA4 event names
EVENT_FORM=form_submit
EVENT_QUOTE=quote_request
EVENT_PHONE=phone_click
EVENT_EMAIL=email_click
EVENT_DOWNLOAD=file_download
CRUX_MIN_SESSIONS=300

# Real-user Core Web Vitals from GA4 (see gtm/GTM_WEB_VITALS.md): readings needed per metric, page and device
RUM_MIN_SAMPLES=50

# --- Paid advertising (see SETUP_PAID.md). A platform runs only when ALL of its values are filled. ---
PAID_DAYS=35
PAID_FEED_TOKEN=
# Optional conversion done in the feed, e.g. PAID_REPORT_CURRENCY=INR and PAID_FX=AED:23.8 (leave blank to keep each account's own currency)
PAID_REPORT_CURRENCY=
PAID_FX=
META_ACCESS_TOKEN=
META_AD_ACCOUNTS=
# Google Ads through a Google Sheet written by google-ads-script/export-to-sheet.js (no API approval needed)
GOOGLE_ADS_SHEET_ID=
# Google Ads through the API (needs a developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNTS=

# --- UptimeRobot (see SETUP_UPTIME.md): READ-ONLY API key ---
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_MONITOR_IDS=
