# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# MongoDB Atlas (one line, no quotes). Special characters in the password are URL-encoded automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
MONGODB_DB=tritorc_seo

SITE_ID=tritorc
SITE_URL=https://www.tritorc.com
PORT=8790

# Google
GA4_PROPERTY_ID=
GSC_PROPERTY=https://tritorc.com/
# Full path to the service-account JSON key (keep it outside the repository):
GOOGLE_SERVICE_ACCOUNT_FILE=
# API key for PageSpeed + CrUX:
GOOGLE_API_KEY=

# GA4 event names
EVENT_FORM=form_submit
EVENT_QUOTE=quote_request
EVENT_PHONE=phone_click
EVENT_EMAIL=email_click
EVENT_DOWNLOAD=file_download
CRUX_MIN_SESSIONS=300
